# AWS credentials and bucket — DO NOT commit real secrets to version control
# Replace the placeholder values below with your actual AWS keys and bucket name.

# Application expects these names: AWS_ACCESS_KEY, AWS_SECRET_KEY, AWS_REGION, AWS_BUCKET_NAME
AWS_ACCESS_KEY=YOUR_AWS_ACCESS_KEY_ID_HERE
AWS_SECRET_KEY=YOUR_AWS_SECRET_ACCESS_KEY_HERE
AWS_REGION=ap-southeast-1
AWS_BUCKET_NAME=khokhoahoc-avatar-bucket

# Also provide common CI/CLI env names (mapped) in case scripts/tools use them
AWS_ACCESS_KEY_ID=${AWS_ACCESS_KEY}
AWS_SECRET_ACCESS_KEY=${AWS_SECRET_KEY}
AWS_S3_BUCKET_NAME=${AWS_BUCKET_NAME}

# ==================== EMAIL CONFIGURATION ====================
# SMTP Configuration for Notification Service
# For Gmail, use app password: https://myaccount.google.com/apppasswords

SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password-here

# Platform Configuration
PLATFORM_NAME=Online Learning Platform
SENDER_EMAIL=noreply@onlinelearning.com

# RabbitMQ Configuration (optional overrides)
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest